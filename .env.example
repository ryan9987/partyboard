# Public controller URL shown in the browser-rendered host QR code, for example:
# https://example.com/controller
VITE_CONTROLLER_URL=http://localhost:5173/controller

# Browser-facing Socket.IO server URL.
VITE_SOCKET_URL=http://localhost:3001

# Server port used during local development.
PORT=3001

# Comma-separated browser origins allowed to connect during development.
ALLOWED_ORIGINS=http://localhost:5173
